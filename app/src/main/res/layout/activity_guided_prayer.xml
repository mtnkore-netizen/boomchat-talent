<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:title="Daily Guided Prayer"
            app:titleTextColor="@color/white"
            app:subtitle="Audio &amp; Matching Text"
            app:subtitleTextColor="@color/accent_gold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPrayerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Morning Prayer: Walking in Light &amp; Peace"
                    android:textColor="@color/primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPrayerTheme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Theme: Living Rightly with God and Fellow People"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:textStyle="italic" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/divider" />

                <TextView
                    android:id="@+id/tvPrayerFullText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="8dp"
                    android:text="Heavenly Father, we humble our hearts before Your presence this day.\n\nGuide our steps in wisdom and truth. Help us to speak words of grace, to forgive generously, and to seek peace with everyone around us.\n\nMay our thoughts be aligned with Your will, and may our lives bring glory to Your Holy Name.\n\nIn Jesus' mighty name, Amen."
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

            </LinearLayout>
        </ScrollView>

        <!-- Bottom Audio Player Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:id="@+id/btnPrayerPlay"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_search_input"
                android:backgroundTint="@color/accent"
                android:padding="12dp"
                android:src="@android:drawable/ic_media_play"
                app:tint="@color/primary_dark" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Guided Prayer Audio"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:progressTint="@color/accent"
                    android:thumbTint="@color/accent" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- Upload Prayer FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabUploadPrayer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:layout_marginBottom="80dp"
        android:backgroundTint="@color/accent"
        android:contentDescription="Upload Prayer"
        android:src="@android:drawable/ic_menu_upload"
        app:tint="@color/primary_dark" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
