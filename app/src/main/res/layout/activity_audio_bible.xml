<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/bibleToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:title="Dramatized Audio Bible"
        app:titleTextColor="@color/white"
        app:subtitle="Synchronized Audio &amp; Text"
        app:subtitleTextColor="@color/accent_gold" />

    <!-- Selector Bar: Book and Chapter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="2dp"
        android:orientation="horizontal"
        android:padding="12dp">

        <Spinner
            android:id="@+id/spBook"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="2"
            android:background="@drawable/bg_search_input" />

        <Spinner
            android:id="@+id/spChapter"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_input" />

    </LinearLayout>

    <!-- Verses Matching Text Reader -->
    <ScrollView
        android:id="@+id/scrollBibleText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvBibleVerses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="8dp"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />
    </ScrollView>

    <!-- Bottom Audio Dramatization Player Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_dark"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/btnBiblePlayPause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_search_input"
            android:backgroundTint="@color/accent"
            android:padding="12dp"
            android:src="@android:drawable/ic_media_play"
            app:tint="@color/primary_dark" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAudioTrackTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dramatized Audio Narration"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/sbBibleAudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
