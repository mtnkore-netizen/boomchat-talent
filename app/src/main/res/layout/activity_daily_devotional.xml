<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:title="Guided Daily Devotional"
            app:titleTextColor="@color/white"
            app:subtitle="Living rightly with God and fellow people"
            app:subtitleTextColor="@color/accent_gold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDevotionalTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="The Extraordinary Grace Within"
                    android:textColor="@color/primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDevotionalAuthor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="By TALENT BRUICE &amp; MYSTERY NKORE"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:textStyle="italic" />

                <!-- Scripture Spotlight Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="#FFF8E7"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/accent"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/tvScriptureAnchor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:text="Colossians 3:12-14\n'Put on then, as God's chosen ones, holy and beloved, compassionate hearts, kindness, humility, meekness, and patience, bearing with one another and forgiving one another.'"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="italic" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvDevotionalBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:lineSpacingExtra="7dp"
                    android:text="When God calls us into fellowship with Himself, He equips us with the divine capacity to reflect His goodness to our world. Living rightly with God is intimately tied to living rightly with fellow people.\n\nEvery day presents choices: will we react in selfishness or respond with Christ-like patience? Aluta Continua—the spiritual struggle continues, but the victory is already sealed in Christ."
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="PRAYER POINT"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPrayerPoint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Lord, grant me a compassionate heart and the strength to live at peace with all people today."
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabUploadDevotional"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:backgroundTint="@color/accent"
        android:src="@android:drawable/ic_menu_upload"
        app:tint="@color/primary_dark" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
